# Copier en .env (racine) et compléter. Le fichier .env est ignoré par git.

# --- Domaine ---
DOMAIN=symnodes.com
DOMAIN_URL=https://symnodes.com
PREDOMAIN_URL=https://preprod.symnodes.com

# --- MongoDB ---
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=changez-moi
MONGO_DBNAME=ecommerce

# --- Application ---
JWT_SECRET=changez-moi
# Compte administrateur créé par le seed (backend/seeder.js)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@exemple.com
ADMIN_PASSWORD=changez-moi
SESSION_SECRET=changez-moi
NOTIFY_RECIPIENT=admin@exemple.com

# --- SMTP (microservice notifications) ---
EMAIL_USER=
EMAIL_APPLICATION_PASSWORD=

# --- Supervision (E26) ---
GRAFANA_ADMIN_PASSWORD=changez-moi
ALERT_EMAIL=admin@exemple.com
SMTP_SMARTHOST=smtp.gmail.com:587
